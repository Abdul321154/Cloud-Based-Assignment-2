datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ActivityConfig {
  id           String   @id @default(cuid())
  name         String
  activityType String
  difficulty   String   @default("medium")
  showHints    Boolean  @default(true)
  numGuesses   Int?
  rows         Int?
  cols         Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  words Word[]

  @@index([activityType])
}

model Word {
  id         String   @id @default(cuid())
  activityId String
  activity   ActivityConfig @relation(fields: [activityId], references: [id], onDelete: Cascade)
  english    String?
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  phonemes Phoneme[]

  @@index([activityId])
}

model Phoneme {
  id       String @id @default(cuid())
  wordId   String
  word     Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)
  symbol   String
  position Int    @default(0)

  @@index([wordId])
}
